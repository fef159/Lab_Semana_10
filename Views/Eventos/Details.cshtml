@model EventoResumen
@{
    ViewData["Title"] = "Detalle del evento";
}

<div class="ev-page-header">
    <div>
        <h1>@Model.Titulo</h1>
        <p>@Model.Categoria &middot; @Model.Lugar</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    </div>
</div>

<div class="ev-stat-grid">
    <div class="ev-card ev-stat"><div class="valor">@Model.Aforo</div><div class="etiqueta">Aforo</div></div>
    <div class="ev-card ev-stat"><div class="valor">@Model.Inscritos</div><div class="etiqueta">Inscritos confirmados</div></div>
    <div class="ev-card ev-stat"><div class="valor">@Model.Cupos</div><div class="etiqueta">Cupos disponibles</div></div>
</div>

<div class="ev-card">
    <div class="ev-card-body">
        <dl class="ev-dl">
            <dt>Título</dt><dd>@Model.Titulo</dd>
            <dt>Categoría</dt><dd>@Model.Categoria</dd>
            <dt>Fecha</dt><dd>@Model.Fecha.ToString("dd/MM/yyyy HH:mm") h</dd>
            <dt>Lugar</dt><dd>@Model.Lugar</dd>
            <dt>Modalidad</dt>
            <dd><span class="ev-badge @(Model.Modalidad == "Virtual" ? "ev-badge-virtual" : "ev-badge-primary")">@Model.Modalidad</span></dd>
            <dt>Precio</dt><dd>@(Model.Precio == 0 ? "Gratis" : "S/ " + Model.Precio.ToString("N2"))</dd>
        </dl>
    </div>
</div>
